# ==============================================================================
# SHOPIFY APP CREDENTIALS (From Shopify Partners Dashboard > App Setup)
# ==============================================================================
SHOPIFY_API_KEY=your_shopify_client_id
SHOPIFY_API_SECRET=your_shopify_client_secret
NEXT_PUBLIC_SHOPIFY_API_KEY=your_shopify_client_id
SHOPIFY_APP_URL=https://apps.krcustomizer.com
SHOPIFY_API_SCOPES=read_products,write_products,read_orders,write_draft_orders,read_themes,write_themes
SHOPIFY_API_VERSION=2025-01

# ==============================================================================
# DATABASE (Prisma ORM)
# ==============================================================================
DATABASE_URL="mysql://admin_krcbackend:Password@localhost:3306/admin_krcbackend"

# ==============================================================================
# KR CUSTOMIZER CORE BACKEND & FRONTEND
# ==============================================================================
STORE_API_ENDPOINT=https://backend.krcustomizer.com/api/
STORE_API_TOKEN=kusheldigi-admin
CUSTOMIZER_FRONTEND_URL=https://front.krcustomizer.com/

# ==============================================================================
# ENVIRONMENT
# ==============================================================================
NODE_ENV=production
PORT=3000
